{
  "name": "vclip",
  "version": "0.3.4",
  "description": "VClip - 基于本地语音识别与 AI 的智能视频切片工具",
  "main": "./out/main/index.js",
  "author": "vclip",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyfirstname/videoclip.git"
  },
  "homepage": "https://github.com/wyfirstname/videoclip#readme",
  "bugs": {
    "url": "https://github.com/wyfirstname/videoclip/issues"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --skipLibCheck",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --skipLibCheck",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "scan:secrets": "node scripts/scan-secrets.js --all",
    "verify:asar": "node test/e2e/verify-asar.js",
    "scan:key": "node test/e2e/scan-real-key.js",
    "verify:dist": "node scripts/verify-dist.js"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "antd": "^5.21.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sherpa-onnx-node": "^1.10.30"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "ffmpeg-static": "^5.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
